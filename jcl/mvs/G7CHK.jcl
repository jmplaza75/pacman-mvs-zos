//PACG7C02 JOB (1),'PACMAN G7 GDDM CHECK',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//* MVS-G7 READ-ONLY CHECK FOR A GDDM LOAD LIBRARY (ROADMAP ROW 7)
//* CATALOG NAMES/ALIASES, LINKLIST, LINK/LPA/CMD MEMBER NAMES
//CAT      EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=A
//SYSIN    DD *
  LISTCAT ALIAS
  LISTCAT NONVSAM NAME
/*
//LNKLST   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=SYS1.PARMLIB(LNKLST00),DISP=SHR
//SYSUT2   DD SYSOUT=A
//TSO      EXEC PGM=IKJEFT01
//SYSTSPRT DD SYSOUT=A
//SYSTSIN  DD *
 LISTDS 'SYS1.LINKLIB' MEMBERS
 LISTDS 'SYS2.LINKLIB' MEMBERS
 LISTDS 'SYS1.LPALIB' MEMBERS
 LISTDS 'SYS2.CMDLIB' MEMBERS
 LISTDS 'SYS1.CMDLIB' MEMBERS
 LISTDS 'SYS1.PPLIB' MEMBERS
 LISTDS 'SYS1.PL1LIB' MEMBERS
 LISTDS 'SYS2.DSSLIB' MEMBERS
/*
//
