//PACCLS02 JOB (1),'PACMAN CLIST UPD',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//* REPLACES MEMBER PACMAN IN THE EXISTING HERC01.PACMAN.CLIST.
//STORE    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSUT2   DD DSN=HERC01.PACMAN.CLIST(PACMAN),DISP=OLD
//SYSIN    DD DUMMY
//SYSUT1   DD DATA,DLM=ZZ
PROC 0 AI(1) GHOSTS(1)
/* PACMAN INTERACTIVE LAUNCHER (MVS-8). RUN FROM TSO READY:        */
/*    EXEC 'HERC01.PACMAN.CLIST(PACMAN)'                           */
/*    EXEC 'HERC01.PACMAN.CLIST(PACMAN)' 'AI(3) GHOSTS(2)'         */
/* AI: 0 STILL 1 RANDOM 2 PERSISTENT 3 CHASE.  GHOSTS: 1-3.        */
/* COMMANDS U/D/L/R, Q QUITS, EMPTY ENTER REDRAWS THE BOARD.       */
ALLOC F(SYSIN) DA(*) REUSE
ALLOC F(SYSOUT) DA(*) REUSE
CALL 'HERC01.PACMAN.LOAD(PACMAIN)' 'TSO AI&AI &GHOSTS'
FREE F(SYSIN SYSOUT)
ZZ
//
