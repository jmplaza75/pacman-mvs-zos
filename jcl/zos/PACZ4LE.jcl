//PACZ4LE JOB 1,'PACMAN ZOS4 Z4LE',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//D1       EXEC PGM=ZHELLO31,COND=(0,NE),
//             PARM='ZHARG/RPTOPTS(ON)'
//STEPLIB  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=A
//CEEDUMP  DD SYSOUT=A
//SYSUDUMP DD DUMMY
//D2       EXEC PGM=ZHELLO24,COND=(0,NE),
//             PARM='ZHARG/RPTOPTS(ON)'
//STEPLIB  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//CEEOPTS  DD *
ALL31(OFF),STACK(,,BELOW)
/*
//SYSOUT   DD SYSOUT=A
//CEEDUMP  DD SYSOUT=A
//SYSUDUMP DD DUMMY
//D3       EXEC PGM=ZHELLO31,COND=(0,NE),
//             PARM='ZHARG/STACK(,,ANYWHERE),RPTOPTS(ON)'
//STEPLIB  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//CEEOPTS  DD *
ALL31(ON),STACK(,,BELOW)
/*
//SYSOUT   DD SYSOUT=A
//CEEDUMP  DD SYSOUT=A
//SYSUDUMP DD DUMMY
