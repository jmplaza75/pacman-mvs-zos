//            RECFM=U,BLKSIZE=32760,UNIT=SYSALLDA,SPACE=(CYL,(2,1,5))
//SYSIN    DD *
  COPY OUTDD=T,INDD=I
  SELECT MEMBER=((PACZ2D,PACMAIN))
/*
