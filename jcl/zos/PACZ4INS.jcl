//PACZ4INS JOB 1,'PACMAN ZOS4 INS',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//SAVETPL  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@@HLQ@@.PACMAN.CLIST(PACMAN),DISP=SHR
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.CLIST(PACSRCT),DISP=SHR
//CEEOPT   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.CEEOPTS,DISP=(NEW,CATLG,CATLG),
//            RECFM=FB,LRECL=80,BLKSIZE=80,SPACE=(TRK,(1,1))
//SYSUT1   DD *
ALL31(OFF),STACK(,,BELOW)
/*
//PROM1    EXEC PGM=IEBCOPY,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//I        DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
