//PACZ4Z3 JOB 1,'PACMAN ZOS4 Z4Z3',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//ALLOC    EXEC PGM=IEFBR14
//D1       DD DSN=@@HLQ@@.PACMAN.Z4CL.T3,DISP=(NEW,CATLG,CATLG),
//            DSNTYPE=PDS,DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80,
//            SPACE=(TRK,(2,1,2))
//Z2CEE    EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CY3.CEEOPTS,DISP=(NEW,CATLG,CATLG),
//            RECFM=FB,LRECL=80,BLKSIZE=80,SPACE=(TRK,(1,1))
//SYSUT1   DD *
ALL31(OFF),STACK(,,BELOW)
/*
//Z2CLS1   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T3(Z2Y),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
CONTROL LIST
SET &W = C
ALLOC F(SYSIN) DUMMY REUSE
ALLOC F(SYSOUT) DUMMY REUSE
/* Z2 (ZOS-4): LE PROFILE A FOR THE CALL. THE TSO SESSION HAS NO   */
/* CEEOPTS (IBM DEFAULTS ALL31(ON), STACK ANYWHERE): ALLOCATE ONE.  */
/* NO DATASET, A FAILED CHECK OR A CEEOPTS DD ALREADY: NO GAME, RC 8.*/
SET &D = &SYSDSN('@@HLQ@@.PACMAN.Z4CY3.CEEOPTS')
IF &STR(&D) NE OK THEN DO
  IF &STR(&D) = &STR(DATASET NOT FOUND) THEN DO
    WRITE PACMAN: @@HLQ@@.PACMAN.Z4CY3.CEEOPTS MISSING, GAME NOT STARTED
  END
  ELSE DO
    WRITE PACMAN: CEEOPTS CHECK FAILED (&D), GAME NOT STARTED
  END
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
/* NO REUSE: AN EXISTING CEEOPTS DD MAKES THE ALLOC FAIL, IT STAYS. */
SET &Z = 0
CONTROL NOFLUSH
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CY3.CEEOPTS') SHR
ERROR OFF
CONTROL FLUSH
IF &Z NE 0 THEN DO
  WRITE PACMAN: A CEEOPTS DD IS ALREADY ALLOCATED, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
WRITE Z2 CALL REACHED
LISTALC STATUS
FREE F(CEEOPTS)
LISTALC STATUS
FREE F(SYSIN SYSOUT)
WRITE Z2 END
ZZ
//Z2CLS2   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T3(Z2N),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
CONTROL LIST
SET &W = C
ALLOC F(SYSIN) DUMMY REUSE
ALLOC F(SYSOUT) DUMMY REUSE
/* Z2 (ZOS-4): LE PROFILE A FOR THE CALL. THE TSO SESSION HAS NO   */
/* CEEOPTS (IBM DEFAULTS ALL31(ON), STACK ANYWHERE): ALLOCATE ONE.  */
/* NO DATASET, A FAILED CHECK OR A CEEOPTS DD ALREADY: NO GAME, RC 8.*/
SET &D = &SYSDSN('@@HLQ@@.PACMAN.Z4CN3.CEEOPTS')
IF &STR(&D) NE OK THEN DO
  IF &STR(&D) = &STR(DATASET NOT FOUND) THEN DO
    WRITE PACMAN: @@HLQ@@.PACMAN.Z4CN3.CEEOPTS MISSING, GAME NOT STARTED
  END
  ELSE DO
    WRITE PACMAN: CEEOPTS CHECK FAILED (&D), GAME NOT STARTED
  END
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
/* NO REUSE: AN EXISTING CEEOPTS DD MAKES THE ALLOC FAIL, IT STAYS. */
SET &Z = 0
CONTROL NOFLUSH
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CN3.CEEOPTS') SHR
ERROR OFF
CONTROL FLUSH
IF &Z NE 0 THEN DO
  WRITE PACMAN: A CEEOPTS DD IS ALREADY ALLOCATED, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
WRITE Z2 CALL REACHED
LISTALC STATUS
FREE F(CEEOPTS)
LISTALC STATUS
FREE F(SYSIN SYSOUT)
WRITE Z2 END
ZZ
//Z2CLS3   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T3(Z2RUN),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 1 M
EXEC '@@HLQ@@.PACMAN.Z4CL.T3(&M)'
WRITE Z2RC=&LASTCC
ZZ
//CLT      EXEC PGM=IKJEFT01,COND=(0,NE),DYNAMNBR=200
//SYSTSPRT DD SYSOUT=A
//SYSTSIN  DD *
  EXEC '@@HLQ@@.PACMAN.Z4CL.T3(Z2RUN)' 'Z2Y'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T3(Z2RUN)' 'Z2N'
  ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CL.T3(Z2N)') SHR
  LISTALC STATUS
  EXEC '@@HLQ@@.PACMAN.Z4CL.T3(Z2RUN)' 'Z2Y'
  LISTALC STATUS
  FREE F(CEEOPTS)
/*
