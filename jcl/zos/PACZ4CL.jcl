//PACZ4CL JOB 1,'PACMAN ZOS4 Z4CL',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//ALLOC    EXEC PGM=IEFBR14
//D1       DD DSN=@@HLQ@@.PACMAN.Z4CL.T1,DISP=(NEW,CATLG,CATLG),
//            DSNTYPE=PDS,DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80,
//            SPACE=(TRK,(2,1,2))
//D2       DD DSN=@@HLQ@@.PACMAN.Z4HSY.DATA,DISP=(NEW,CATLG,CATLG),
//            DSNTYPE=PDS,DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80,
//            SPACE=(TRK,(1,1,5))
//G8CLS    EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(PARMS),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0 AI(1) GHOSTS(1) COLOR(AUTO) HILITE(AUTO) ANIM(AUTO) +
  REDRAW(PARTIAL) METRICS(NO) GLYPHS(AUTO) SCALE(AUTO) CANVAS(AUTO) +
  PLAY(REALTIME) SOUND(AUTO) RULES(ARCADE) LEVEL(1) SPEED(NORMAL) +
  ALARM(PATTERN)
SET &C = &SUBSTR(1:1,&COLOR)
SET &H = &SUBSTR(1:1,&HILITE)
SET &A = &SUBSTR(1:1,&ANIM)
SET &R = &SUBSTR(1:1,&REDRAW)
SET &G = &SUBSTR(1:1,&GLYPHS)
SET &S = &SUBSTR(1:1,&SCALE)
SET &V = &SUBSTR(1:1,&CANVAS)
SET &Y = &SUBSTR(1:1,&PLAY)
SET &U = &SUBSTR(1:1,&SOUND)
SET &W = &SUBSTR(1:1,&RULES)
SET &F = &SUBSTR(1:1,&SPEED)
SET &K = &SUBSTR(1:1,&ALARM)
/* LEVEL ZERO-PADDED TO 2 DIGITS: SPEED IS PARM COLUMN 24, ALARM 25.*/
SET &L = &STR(&LEVEL)
IF &LENGTH(&STR(&L)) = 1 THEN SET &L = &STR(0&L)
IF &LENGTH(&STR(&L)) NE 2 THEN SET &L = &STR(01)
SET &M = N
IF &METRICS = YES THEN SET &M = M
/* A FAILED ALLOC WOULD END THE CLIST (PROBE E16): CHECK FIRST.    */
/* THE PARM IS BUILT FIRST: A CLIST LINE ENDS AT COLUMN 72.        */
SET &P = &STR(TSO AI&AI &GHOSTS &M&C&H&A&R&G&S&V&Y&U&W&L&F&K)
WRITE G8PARM=&P=
ZZ
//HSCLS1   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(HSCLY),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = A
IF &W = A THEN DO
  IF &SYSDSN('@@HLQ@@.PACMAN.Z4HSY.DATA') = OK THEN +
    ALLOC F(PACHS) DA('@@HLQ@@.PACMAN.Z4HSY.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
LISTALC STATUS
IF &W = A THEN FREE F(PACHS)
WRITE HSCL END
ZZ
//HSCLS2   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(HSCLN),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = A
IF &W = A THEN DO
  IF &SYSDSN('@@HLQ@@.PACMAN.Z4HSN.DATA') = OK THEN +
    ALLOC F(PACHS) DA('@@HLQ@@.PACMAN.Z4HSN.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
LISTALC STATUS
IF &W = A THEN FREE F(PACHS)
WRITE HSCL END
ZZ
//Z2CEE    EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CEY.CEEOPTS,DISP=(NEW,CATLG,CATLG),
//            RECFM=FB,LRECL=80,BLKSIZE=80,SPACE=(TRK,(1,1))
//SYSUT1   DD *
ALL31(OFF),STACK(,,BELOW)
/*
//Z2CLS1   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(Z2Y),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = C
ALLOC F(SYSIN) DUMMY REUSE
ALLOC F(SYSOUT) DUMMY REUSE
/* Z2 (ZOS-4): LE PROFILE A FOR THE CALL. THE TSO SESSION HAS NO   */
/* CEEOPTS (IBM DEFAULTS ALL31(ON), STACK ANYWHERE): ALLOCATE ONE.  */
/* MISSING DATASET OR A CEEOPTS DD ALREADY THERE: NO GAME, RC 8.    */
IF &SYSDSN('@@HLQ@@.PACMAN.Z4CEY.CEEOPTS') NE OK THEN DO
  WRITE PACMAN: @@HLQ@@.PACMAN.Z4CEY.CEEOPTS MISSING, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
/* NO REUSE: AN EXISTING CEEOPTS DD MAKES THE ALLOC FAIL, IT STAYS. */
SET &Z = 0
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CEY.CEEOPTS') SHR
ERROR OFF
IF &Z NE 0 THEN DO
  WRITE PACMAN: A CEEOPTS DD IS ALREADY ALLOCATED, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
WRITE Z2 CALL REACHED
LISTALC STATUS
FREE F(CEEOPTS)
LISTALC STATUS
FREE F(SYSIN SYSOUT)
WRITE Z2 END
ZZ
//Z2CLS2   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(Z2N),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = C
ALLOC F(SYSIN) DUMMY REUSE
ALLOC F(SYSOUT) DUMMY REUSE
/* Z2 (ZOS-4): LE PROFILE A FOR THE CALL. THE TSO SESSION HAS NO   */
/* CEEOPTS (IBM DEFAULTS ALL31(ON), STACK ANYWHERE): ALLOCATE ONE.  */
/* MISSING DATASET OR A CEEOPTS DD ALREADY THERE: NO GAME, RC 8.    */
IF &SYSDSN('@@HLQ@@.PACMAN.Z4CEN.CEEOPTS') NE OK THEN DO
  WRITE PACMAN: @@HLQ@@.PACMAN.Z4CEN.CEEOPTS MISSING, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
/* NO REUSE: AN EXISTING CEEOPTS DD MAKES THE ALLOC FAIL, IT STAYS. */
SET &Z = 0
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CEN.CEEOPTS') SHR
ERROR OFF
IF &Z NE 0 THEN DO
  WRITE PACMAN: A CEEOPTS DD IS ALREADY ALLOCATED, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
WRITE Z2 CALL REACHED
LISTALC STATUS
FREE F(CEEOPTS)
LISTALC STATUS
FREE F(SYSIN SYSOUT)
WRITE Z2 END
ZZ
//Z2CLS3   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.Z4CL.T1(Z2RUN),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 1 M
EXEC '@@HLQ@@.PACMAN.Z4CL.T1(&M)'
WRITE Z2RC=&LASTCC
ZZ
//CLT      EXEC PGM=IKJEFT01,COND=(0,NE)
//SYSTSPRT DD SYSOUT=A
//SYSTSIN  DD *
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(PARMS)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(PARMS)' 'RULES(CLASSIC)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(PARMS)' +
  'RULES(ARCADE) SPEED(FAST) ALARM(SINGLE)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(PARMS)' 'PLAY(TURN) RULES(XYZ) LEVEL(5)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(HSCLY)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(HSCLN)'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(Z2RUN)' 'Z2Y'
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(Z2RUN)' 'Z2N'
  ALLOC F(CEEOPTS) DA('@@HLQ@@.PACMAN.Z4CL.T1(PARMS)') SHR
  EXEC '@@HLQ@@.PACMAN.Z4CL.T1(Z2RUN)' 'Z2Y'
  LISTALC STATUS
  FREE F(CEEOPTS)
/*
