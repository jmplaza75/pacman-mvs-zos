//PACZ8RPE JOB 1,'PACMAN ZOS8 B2',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//COB      EXEC PGM=IGYCRCTL,COND=(4,LT),REGION=0M,
//             PARM=('RENT,RMODE(24),DATA(24),NODYNAM',
//             'TRUNC(STD),NUMPROC(NOPFD),NOSOURCE,NOXREF')
//STEPLIB  DD DSN=IGY650.SIGYCOMP,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//         DD DSN=CEE.SCEERUN2,DISP=SHR
//SYSIN    DD DSN=@@HLQ@@.PACMAN.COBOL(PACRPE),DISP=SHR
//SYSLIB   DD DSN=@@HLQ@@.PACMAN.COPY,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=@@HLQ@@.PACMAN.OBJ(PACRPE),DISP=SHR
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT5   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT6   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT7   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT8   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT9   DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT10  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT11  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT12  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT13  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT14  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSUT15  DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//SYSMDECK DD UNIT=SYSALLDA,SPACE=(TRK,(5,5))
//LINK     EXEC PGM=IEWBLINK,COND=(4,LT),
//             PARM='LIST,AMODE=24,RMODE=24,RENT'
//SYSLIB   DD DSN=CEE.SCEELKEX,DISP=SHR
//         DD DSN=CEE.SCEELKED,DISP=SHR
//OBJ      DD DSN=@@HLQ@@.PACMAN.OBJ,DISP=SHR
//SYSLMOD  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD *
  INCLUDE OBJ(PACRPE)
  INCLUDE OBJ(PACFSIO)
  INCLUDE OBJ(PACHSIO)
  ENTRY PACRPE
  NAME PACRPE(R)
/*
//E1       EXEC PGM=PACRPE,COND=((0,NE,COB),(0,NE,LINK)),
//         PARM='E1'
//STEPLIB  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//CEEOPTS  DD *
ALL31(OFF),STACK(,,BELOW)
/*
//SYSOUT   DD SYSOUT=A
//CEEDUMP  DD SYSOUT=A
//SYSUDUMP DD DUMMY
//E2       EXEC PGM=PACRPE,COND=((0,NE,COB),(0,NE,LINK),EVEN),
//         PARM='E2'
//STEPLIB  DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//CEEOPTS  DD *
ALL31(OFF),STACK(,,BELOW)
/*
//PACHS    DD DSN=@@HLQ@@.PACMAN.HS8.T1(HISCORE),DISP=SHR
//SYSOUT   DD SYSOUT=A
//CEEDUMP  DD SYSOUT=A
//SYSUDUMP DD DUMMY
