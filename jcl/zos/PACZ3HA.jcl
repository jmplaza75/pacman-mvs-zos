//PACZ3HA JOB 1,'PACMAN ZOS3 Z3HA',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//ALLOC    EXEC PGM=IEFBR14
//D1       DD DSN=@@HLQ@@.PACMAN.HSTEST.T1,DISP=(NEW,CATLG,CATLG),
//            DSNTYPE=PDS,DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80,
//            SPACE=(TRK,(5,1,5))
//D2       DD DSN=@@HLQ@@.PACMAN.HSFULL.T1,DISP=(NEW,CATLG,CATLG),
//            DSNTYPE=PDS,DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80,
//            SPACE=(TRK,(5,1,1))
//HSSEED1  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.HSTEST.T1(HS9),DISP=OLD
//SYSUT1   DD *
9999999 PACHS001 099
/*
//HSSEED2  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@@HLQ@@.PACMAN.HSTEST.T1(BAD),DISP=OLD
//SYSUT1   DD *
XYZZY NOT A SCORE
SECOND JUNK RECORD
