PROC 0 CASE(E1)
/* MVS-RP RP.0 ESTAE LIVE TEST (D39; TEST DRIVER, NOT THE GAME):    */
/*    EXEC '@@PREFIX@@.CLIST(RPESTAE)' 'CASE(E1)'   (E1, E2, E3)    */
/* E2 READS THE HIGH-SCORE MEMBER FIRST (READ ONLY, NEVER WRITES).  */
ALLOC F(SYSOUT) DA(*) REUSE
IF &CASE = E2 THEN DO
  IF &SYSDSN('@@PREFIX@@.DATA') = OK THEN +
    ALLOC F(PACHS) DA('@@PREFIX@@.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
CALL '@@PREFIX@@.LOAD(PACRPE)' '&CASE'
WRITE RPESTAE &CASE AFTER CALL LASTCC=&LASTCC
IF &CASE = E2 THEN FREE F(PACHS)
FREE F(SYSOUT)
