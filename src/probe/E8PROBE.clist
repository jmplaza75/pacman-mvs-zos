PROC 0 R(0)
/* MVS-G3 PROBE E8: PROTOCOL BISECT FROM PROBE E6. RUNG 0 = E6, EACH */
/* NEXT RUNG ADDS ONE FACTOR (SEE SRC/PROBE PACFS8). ONE RUNG PER    */
/* CLEAN TSO SESSION:  EXEC '@@PREFIX@@.CLIST(E8PROBE)' 'R(0)'       */
ALLOC F(SYSOUT) DA(*) REUSE
CALL '@@PREFIX@@.LOAD(PACE8P)' '&R'
FREE F(SYSOUT)
