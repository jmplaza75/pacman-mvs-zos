PROC 0 VAR(Q) PH(A) SHORT() LOG()
/* MVS-RT TIMING/INPUT PROBE E14 (ISOLATED FROM PACMAN):            */
/*    EXEC '@@PREFIX@@.CLIST(RTPROBE)' 'VAR(Q)'                      */
/* VAR: Q = COLOR(AUTO) QUERY PATH, N = NO QUERY (COLOR(YES)).       */
/* PH: A ALL, T TIMING ONLY, I INPUT ONLY. SHORT(S): 30 QUANTA.      */
/* LOG: SUFFIX OF THE LOG DATASET E14<LOG> (Q N T U), DEFAULT = VAR. */
IF &STR(&LOG) = &STR() THEN SET &LOG = &VAR
ALLOC F(SYSOUT) DA(*) REUSE
ALLOC F(E14LOG) DA('@@PREFIX@@.E14&LOG') OLD REUSE
CALL '@@PREFIX@@.LOAD(PACRTP)' '&VAR&PH&SHORT'
FREE F(E14LOG)
FREE F(SYSOUT)
