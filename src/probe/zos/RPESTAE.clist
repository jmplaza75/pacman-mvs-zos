PROC 0 CASE(E1)
/* ZOS-8 STAGE D: THE RP.0 ESTAE TEST (D39) ON Z/OS. TEST DRIVER,   */
/* NOT THE GAME; NEVER PROMOTED.                                    */
/*    EXEC '@@PREFIX@@.CLIST(RPESTAE)' 'CASE(E1)'   (E1, E2, E3)    */
/* E2 READS THE TEST MEMBER HS8.T1(HISCORE) FIRST (READ ONLY).      */
/* THE Z2 STATEMENTS OF THE Z/OS PACMAN CLIST GIVE THE AMODE 24     */
/* PACRPE LE PROFILE A (CEEOPTS), FREED AFTER THE CALL.             */
ALLOC F(SYSOUT) DA(*) REUSE
IF &CASE = E2 THEN DO
  IF &SYSDSN('@@PREFIX@@.HS8.T1') = OK THEN +
    ALLOC F(PACHS) DA('@@PREFIX@@.HS8.T1(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
SET &D = &SYSDSN('@@PREFIX@@.CEEOPTS')
IF &STR(&D) NE OK THEN DO
  WRITE RPESTAE: CEEOPTS CHECK FAILED (&D), NOT STARTED
  FREE F(SYSOUT)
  IF &CASE = E2 THEN FREE F(PACHS)
  EXIT CODE(8)
END
SET &Z = 0
CONTROL NOFLUSH
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@PREFIX@@.CEEOPTS') SHR
ERROR OFF
CONTROL FLUSH
IF &Z NE 0 THEN DO
  WRITE RPESTAE: A CEEOPTS DD IS ALREADY ALLOCATED, NOT STARTED
  FREE F(SYSOUT)
  IF &CASE = E2 THEN FREE F(PACHS)
  EXIT CODE(8)
END
CALL '@@PREFIX@@.LOAD(PACRPE)' '&CASE'
WRITE RPESTAE &CASE AFTER CALL LASTCC=&LASTCC
FREE F(CEEOPTS)
IF &CASE = E2 THEN FREE F(PACHS)
FREE F(SYSOUT)
