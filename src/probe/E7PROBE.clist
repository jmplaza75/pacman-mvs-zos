PROC 0 V(A)
/* MVS-G3 PROBE E7 (WHY IDLE TICKS ARE NOT SHOWN BEFORE THE FIRST AID).  */
/* VARIANTS (ONE FACTOR FROM A): B TGET NOWAIT, C B+WCC C3, D NO      */
/* INITIAL=YES, T 2 S WAIT, K WCC C3, Q NO QUERY, P NO CLEAR PREFIX,  */
/* F NO 3270 FIELDS, I TICKS AS THE GAME'S LOGICAL PARTIALS (C3+IC).  */
/*    EXEC '@@PREFIX@@.CLIST(E7PROBE)' 'V(A)'                           */
ALLOC F(SYSOUT) DA(*) REUSE
CALL '@@PREFIX@@.LOAD(PACE7P)' '&V'
FREE F(SYSOUT)
