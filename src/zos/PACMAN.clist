PROC 0 AI(1) GHOSTS(1) COLOR(AUTO) HILITE(AUTO) ANIM(AUTO) +
  REDRAW(PARTIAL) METRICS(NO) GLYPHS(AUTO) SCALE(AUTO) CANVAS(AUTO) +
  PLAY(REALTIME) SOUND(AUTO) RULES(ARCADE) LEVEL(1) SPEED(NORMAL) +
  ALARM(PATTERN)
/* PACMAN INTERACTIVE LAUNCHER. RUN FROM TSO READY:                */
/*    EXEC '@@PREFIX@@.CLIST(PACMAN)'                       */
/* EXEC '@@PREFIX@@.CLIST(PACMAN)' 'AI(3) GHOSTS(2) COLOR(NO)' */
/* AI: 0 STILL 1 RANDOM 2 PERSISTENT 3 CHASE.  GHOSTS: 1-3.        */
/* COLOR: AUTO (ASK THE TERMINAL), YES, NO (MONOCHROME LINE MODE). */
/* HILITE: AUTO (QCODE 87), YES, NO (COLOUR ONLY, NO HIGHLIGHTS).  */
/* ANIM: AUTO/YES (P AND G CHANGE GLYPH), NO.  REDRAW: PARTIAL      */
/* (ONLY CHANGED CELLS) OR FULL (WHOLE SCREEN, DIAGNOSTIC).         */
/* METRICS(YES): METRICS AND RECTRACE LINES AT THE END (DIAGNOSTIC).*/
/* GLYPHS: AUTO (GE + APL SET IN THE QUERY REPLY), GRAPHIC (BOX     */
/* WALLS, APL SPRITES), BASE (+ - | WALLS), CLASSIC (# . LOOK).     */
/* CANVAS: AUTO (USE THE TERMINAL'S LARGER ALTERNATE SCREEN, E.G.  */
/* 120X27 WITH 'C3270 -MODEL 2 -OVERSIZE AUTO'), DEFAULT (80X24).   */
/* SIZE THE WINDOW BEFORE CONNECTING; NEVER SHRINK IT WHILE ON.     */
/* SCALE: AUTO (4X2 WHEN COLOUR, HIGHLIGHT AND GRAPHIC GLYPHS ARE   */
/* ALL ACTIVE), 4 (4X2), 3 (3X2), NO (THE GLYPHS LOOK, NOT SCALED). */
/* TK4-/C3270: 'COLOR(YES) HILITE(YES) GLYPHS(GRAPHIC)' = GRAPHIC   */
/* LOOK WITH IMMEDIATE ANIMATION (COLOR(YES) SKIPS THE QUERY), 4X2  */
/* SCALED BY DEFAULT (SCALE(AUTO)).                                 */
/* PLAY: REALTIME (DEFAULT, MVS-RT: PAC-MAN MOVES BY ITSELF EVERY  */
/* 150 MS, SEE SPEED; ARROWS = PF7/8/10/11, P = PF9 PAUSE WITH THE */
/* TOOLS/C3270_RT.SH KEYMAP; NEEDS COLOUR MODE, ELSE TURN) OR TURN  */
/* (ONE MOVE PER COMMAND, THE MVS-GS GAME).                         */
/* SOUND: AUTO/YES (MVS-S1: 3270 ALARM ON START, DEATH AND WIN IN */
/* COLOUR MODE; THE TERMINAL'S BELL MUST BE ON), NO (SILENT).      */
/* ALARM: PATTERN (MVS-S2: START 1 BELL, DEATH 2, EXTRA LIFE 2,     */
/* LEVEL CLEAR 3, GAME OVER 3, WIN 4) OR SINGLE (ONE BELL EACH).    */
/* RULES: ARCADE (DEFAULT SINCE 2.0-MVS-MAX: POWER PELLETS O,      */
/* FRIGHTENED GHOSTS, 200/400/800/1600, LEVELS, FRUIT, HIGH SCORE)  */
/* OR CLASSIC (THE 1.0-MVS GAME, COMPATIBILITY MODE).               */
/* LEVEL: START LEVEL 1-99 FOR RULES(ARCADE) (MVS-GP2), DEFAULT 1;  */
/* A FRESH GAME AT THAT LEVEL. ANY OTHER VALUE STARTS AT LEVEL 1.   */
/* SPEED: NORMAL (150 MS QUANTUM) OR FAST (125 MS: PAC-MAN AND THE */
/* GHOSTS MOVE FASTER; FRIGHT, FRUIT, FREEZES, READY! KEEP THEIR    */
/* LENGTH IN TIME). PLAY(REALTIME) ONLY; TURN IGNORES IT.           */
/* HIGH SCORE (MVS-HS): RULES(ARCADE) KEEPS THE TOP SCORE OF GAMES  */
/* STARTED AT LEVEL 1 IN THE DATA DATASET, MEMBER HISCORE. NO DATA  */
/* DATASET = THE GAME RUNS WITHOUT IT ('HIGH SCORE UNAVAILABLE').   */
/* COMMANDS U/D/L/R + ENTER, Q QUITS. REDRAW: EMPTY ENTER (LINE    */
/* MODE) OR PA2 (COLOUR MODE).                                     */
SET &C = &SUBSTR(1:1,&COLOR)
SET &H = &SUBSTR(1:1,&HILITE)
SET &A = &SUBSTR(1:1,&ANIM)
SET &R = &SUBSTR(1:1,&REDRAW)
SET &G = &SUBSTR(1:1,&GLYPHS)
SET &S = &SUBSTR(1:1,&SCALE)
SET &V = &SUBSTR(1:1,&CANVAS)
SET &Y = &SUBSTR(1:1,&PLAY)
SET &U = &SUBSTR(1:1,&SOUND)
SET &W = &SUBSTR(1:1,&RULES)
SET &F = &SUBSTR(1:1,&SPEED)
SET &K = &SUBSTR(1:1,&ALARM)
/* LEVEL ZERO-PADDED TO 2 DIGITS: SPEED IS PARM COLUMN 24, ALARM 25.*/
SET &L = &STR(&LEVEL)
IF &LENGTH(&STR(&L)) = 1 THEN SET &L = &STR(0&L)
IF &LENGTH(&STR(&L)) NE 2 THEN SET &L = &STR(01)
SET &M = N
IF &METRICS = YES THEN SET &M = M
/* Z3 (ZOS-4): SYSIN FIXED 80 (PACINPT COMMAND-FILE) WHATEVER THE  */
/* TERMINAL WIDTH: ON DA(*) ONLY ATTRIB + USING SET THE DCB. THE   */
/* LIST IS FREED AT ONCE (ONLY IF CREATED HERE). FAILURE: RC 8.    */
SET &Z = 0
SET &T = 0
CONTROL NOFLUSH
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ATTRIB Z3SIATTR RECFM(F) LRECL(80) BLKSIZE(80)
IF &Z = 0 THEN DO
  SET &T = 1
  ALLOC F(SYSIN) DA(*) REUSE USING(Z3SIATTR)
END
SET &I = &Z
IF &T = 1 THEN FREE ATTRLIST(Z3SIATTR)
ERROR OFF
CONTROL FLUSH
IF &Z NE 0 THEN DO
  WRITE PACMAN: SYSIN NOT ALLOCATED (Z3, RC &Z), GAME NOT STARTED
  IF &T = 1 AND &I = 0 THEN FREE F(SYSIN)
  EXIT CODE(8)
END
ALLOC F(SYSOUT) DA(*) REUSE
/* A FAILED ALLOC WOULD END THE CLIST (PROBE E16): CHECK FIRST.    */
IF &W = A THEN DO
  IF &SYSDSN('@@PREFIX@@.DATA') = OK THEN +
    ALLOC F(PACHS) DA('@@PREFIX@@.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
/* THE PARM IS BUILT FIRST: A CLIST LINE ENDS AT COLUMN 72.        */
SET &P = &STR(TSO AI&AI &GHOSTS &M&C&H&A&R&G&S&V&Y&U&W&L&F&K)
/* Z2 (ZOS-4): LE PROFILE A FOR THE CALL. THE TSO SESSION HAS NO   */
/* CEEOPTS (IBM DEFAULTS ALL31(ON), STACK ANYWHERE): ALLOCATE ONE.  */
/* NO DATASET, A FAILED CHECK OR A CEEOPTS DD ALREADY: NO GAME, RC 8.*/
SET &D = &SYSDSN('@@PREFIX@@.CEEOPTS')
IF &STR(&D) NE OK THEN DO
  IF &STR(&D) = &STR(DATASET NOT FOUND) THEN DO
    WRITE PACMAN: @@PREFIX@@.CEEOPTS MISSING, GAME NOT STARTED
  END
  ELSE DO
    WRITE PACMAN: CEEOPTS CHECK FAILED (&D), GAME NOT STARTED
  END
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
/* NO REUSE: AN EXISTING CEEOPTS DD MAKES THE ALLOC FAIL, IT STAYS. */
SET &Z = 0
CONTROL NOFLUSH
ERROR DO
  SET &Z = &LASTCC
  RETURN
END
ALLOC F(CEEOPTS) DA('@@PREFIX@@.CEEOPTS') SHR
ERROR OFF
CONTROL FLUSH
IF &Z NE 0 THEN DO
  WRITE PACMAN: A CEEOPTS DD IS ALREADY ALLOCATED, GAME NOT STARTED
  FREE F(SYSIN SYSOUT)
  IF &W = A THEN FREE F(PACHS)
  EXIT CODE(8)
END
CALL '@@PREFIX@@.LOAD(PACMAIN)' '&P'
FREE F(CEEOPTS)
FREE F(SYSIN SYSOUT)
IF &W = A THEN FREE F(PACHS)
