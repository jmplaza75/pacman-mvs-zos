      * PACMAIN : DRIVER ONLY. NO GAME RULES, NO I/O STATEMENTS.
      * PACPLAT (HOST)  PACINPT (CARDS)  PACGAME (RULES)  PACMAP (MAP)
      * PACAI (GHOSTS)  PACDISP (TEXT OUTPUT). SEE DOCS/ARCHITECTURE.MD
       IDENTIFICATION DIVISION.
       PROGRAM-ID. PACMAIN.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-370.
       OBJECT-COMPUTER. IBM-370.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  PAC-STATE COPY PACSTATE.
       01  PAC-REQ COPY PACREQ.
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 'INIT' TO REQ-OP.
           CALL 'PACPLAT' USING PAC-REQ.
           MOVE 'RSET' TO REQ-OP.
           CALL 'PACGAME' USING PAC-STATE PAC-REQ.
           MOVE 'OPEN' TO REQ-OP.
           CALL 'PACINPT' USING PAC-REQ.
           MOVE 'HEAD' TO REQ-OP.
           CALL 'PACDISP' USING PAC-STATE PAC-REQ.
           PERFORM READ-INPUT THRU READ-INPUT-EXIT.
           PERFORM CHECK-CONFIG THRU CHECK-CONFIG-EXIT.
           MOVE 'INIT' TO REQ-OP.
           CALL 'PACGAME' USING PAC-STATE PAC-REQ.
           MOVE 'STAT' TO REQ-OP.
           CALL 'PACDISP' USING PAC-STATE PAC-REQ.
           PERFORM TURN-PARA
               UNTIL F-EOF = 1 OR F-QUIT = 1 OR F-WON = 1
                  OR F-LOST = 1.
           MOVE 'END ' TO REQ-OP.
           CALL 'PACDISP' USING PAC-STATE PAC-REQ.
           MOVE 'CLOS' TO REQ-OP.
           CALL 'PACINPT' USING PAC-REQ.
           MOVE 'FINI' TO REQ-OP.
           CALL 'PACPLAT' USING PAC-REQ.
           STOP RUN.
       READ-INPUT.
           MOVE 'READ' TO REQ-OP.
           CALL 'PACINPT' USING PAC-REQ.
           IF REQ-KIND = 'EOF'
               MOVE 'EOF ' TO REQ-OP
               CALL 'PACGAME' USING PAC-STATE PAC-REQ.
       READ-INPUT-EXIT.
           EXIT.
       CHECK-CONFIG.
           IF REQ-KIND = 'CFG'
               MOVE 'CFG ' TO REQ-OP
               CALL 'PACGAME' USING PAC-STATE PAC-REQ
               PERFORM READ-INPUT THRU READ-INPUT-EXIT.
       CHECK-CONFIG-EXIT.
           EXIT.
       TURN-PARA.
           PERFORM DISPATCH THRU DISPATCH-EXIT.
           PERFORM READ-INPUT THRU READ-INPUT-EXIT.
       DISPATCH.
           IF REQ-KIND = 'MOV'
               MOVE 'MOVE' TO REQ-OP
               CALL 'PACGAME' USING PAC-STATE PAC-REQ
               MOVE 'STAT' TO REQ-OP
               CALL 'PACDISP' USING PAC-STATE PAC-REQ
           ELSE IF REQ-KIND = 'QUI'
               MOVE 'QUIT' TO REQ-OP
               CALL 'PACGAME' USING PAC-STATE PAC-REQ
           ELSE
               MOVE 'INVL' TO REQ-OP
               CALL 'PACDISP' USING PAC-STATE PAC-REQ.
       DISPATCH-EXIT.
           EXIT.
