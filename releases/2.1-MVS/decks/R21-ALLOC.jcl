//PACALC10 JOB (1),'PACMAN ALLOC',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//* FIRST USE ONLY: CREATES THE PROJECT LIBRARIES. NOT IDEMPOTENT AND NEVER
//* DELETES ANYTHING: IF A DATASET EXISTS THE JOB FAILS WITH NOT CATLGD 2.
//ALLOC    EXEC PGM=IEFBR14
//COBOL    DD DSN=HERC01.PACMAN.R21.COBOL,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,2,20)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=3120)
//COPY     DD DSN=HERC01.PACMAN.R21.COPY,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(30,10,10)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=3120)
//LOAD     DD DSN=HERC01.PACMAN.R21.LOAD,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,2,20)),
//            DCB=(DSORG=PO,RECFM=U,BLKSIZE=6144)
//CLIST    DD DSN=HERC01.PACMAN.R21.CLIST,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(2,1,5)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=3120)
//DATA     DD DSN=HERC01.PACMAN.R21.DATA,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1,5)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80)
//
