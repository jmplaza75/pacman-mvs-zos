//PACVER21 JOB (1),'PACMAN VERIFY 2.1',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//* MVS-10 DIAGNOSTIC STEP 3: READ-ONLY. NO COPY, STORE, LINK, ZAP.
//* DUMPS R21 AND INSTALLED PACMAIN, PRINTS THE INSTALLED CLIST.
//MARK     EXEC PGM=IEBGENER
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD *
PACMAN-INST20-ZAP-DUMPS-FOLLOW
/*
//SYSUT2   DD SYSOUT=A
//ZAPSRC   EXEC PGM=AMASPZAP
//SYSPRINT DD SYSOUT=A
//SYSLIB   DD DSN=HERC01.PACMAN.R21.LOAD,DISP=SHR
//SYSIN    DD *
 DUMP PACMAIN ALL
/*
//ZAPINST  EXEC PGM=AMASPZAP
//SYSPRINT DD SYSOUT=A
//SYSLIB   DD DSN=HERC01.PACMAN.LOAD,DISP=SHR
//SYSIN    DD *
 DUMP PACMAIN ALL
/*
//PRINT    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=HERC01.PACMAN.CLIST(PACMAN),DISP=SHR
//SYSUT2   DD SYSOUT=A
//PTPCH    EXEC PGM=IEBPTPCH
//SYSPRINT DD SYSOUT=A
//SYSUT1   DD DSN=HERC01.PACMAN.CLIST,DISP=SHR
//SYSUT2   DD SYSOUT=A
//SYSIN    DD *
 PRINT TYPORG=PO,MAXFLDS=1
 MEMBER NAME=PACMAN
 RECORD FIELD=(80)
/*
//
