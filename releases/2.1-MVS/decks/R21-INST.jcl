//PACINS20 JOB (1),'PACMAN INSTALL 2.0',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//* PROMOTES HERC01.PACMAN.R21.LOAD(PACMAIN) TO HERC01.PACMAN.LOAD
//COPY     EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=A
//R20      DD DSN=HERC01.PACMAN.R21.LOAD,DISP=SHR
//INST     DD DSN=HERC01.PACMAN.LOAD,DISP=OLD
//SYSUT3   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSUT4   DD UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSIN    DD *
  COPY OUTDD=INST,INDD=R20
  SELECT MEMBER=((PACMAIN,,R))
/*
//MARK     EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD *
PACMAN-INST20-ZAP-DUMPS-FOLLOW
/*
//SYSUT2   DD SYSOUT=A
//ZAPSRC   EXEC PGM=AMASPZAP,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSLIB   DD DSN=HERC01.PACMAN.R21.LOAD,DISP=SHR
//SYSIN    DD *
 DUMP PACMAIN ALL
/*
//ZAPINST  EXEC PGM=AMASPZAP,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSLIB   DD DSN=HERC01.PACMAN.LOAD,DISP=SHR
//SYSIN    DD *
 DUMP PACMAIN ALL
/*
//
