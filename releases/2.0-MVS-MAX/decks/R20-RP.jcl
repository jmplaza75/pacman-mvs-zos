//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSLIN   DD DSN=&&OBJQ2,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(80,(500,100)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=HERC01.PACMAN.R20.COBOL(PACQRY),DISP=SHR
