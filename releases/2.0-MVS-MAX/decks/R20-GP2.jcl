//SYSUT2   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSLIN   DD DSN=&&OBJQ2,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(80,(500,100)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=HERC01.PACMAN.R20.COBOL(PACQRY),DISP=SHR
//SYSLIB   DD DSN=HERC01.PACMAN.R20.COPY,DISP=SHR
//LINKQ    EXEC PGM=IEWL,COND=(0,NE),PARM='LIST,XREF'
//SYSLIN   DD DSN=&&OBJQ1,DISP=(OLD,DELETE)
//         DD DSN=&&OBJQ2,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSLMOD  DD DSN=HERC01.PACMAN.R20.LOAD(PACQRYT),DISP=OLD
//SYSLIB   DD DSN=SYS1.COBLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD SYSOUT=A
//SYSIN    DD *
 ENTRY PACQRYT
