/*
//SYSOUT   DD SYSOUT=A
//SYSUDUMP DD SYSOUT=A
//SRCT     EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSUT2   DD DSN=HERC01.PACMAN.R20.COBOL(PACTSOT),DISP=OLD
//SYSIN    DD DUMMY
//SYSUT1   DD DATA,DLM=ZZ
      * PACTSOT : MVS-RT BATCH TEST DRIVER FOR THE PACTSO CLOCK (NOT
      * PART OF THE GAME). TIME, THEN 20 ABSOLUTE DEADLINES 150 MS
      * APART (DLWT), THEN ONE DEADLINE ALREADY PASSED. ONE LINE EACH:
      *   TSOT NN DL=.......... NOW=.......... RC=....
      * (MS SINCE THE FIRST TIME CALL; LATE LINE: TSOT LA ...).
       IDENTIFICATION DIVISION.
       PROGRAM-ID. PACTSOT.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-370.
       OBJECT-COMPUTER. IBM-370.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  T-OP                  PIC X(4).
       01  T-RC                  PIC S9(4) COMP.
       01  T-NOW                 PIC S9(9) COMP.
       01  T-DL                  PIC S9(9) COMP.
       01  T-I                   PIC 99 VALUE 0.
       01  T-LINE.
           05  FILLER            PIC X(5) VALUE 'TSOT '.
           05  TL-I              PIC XX.
           05  FILLER            PIC X(4) VALUE ' DL='.
           05  TL-DL             PIC -(9)9.
           05  FILLER            PIC X(5) VALUE ' NOW='.
           05  TL-NOW            PIC -(9)9.
           05  FILLER            PIC X(4) VALUE ' RC='.
           05  TL-RC             PIC -(4)9.
       01  T-NUM                 PIC 99.
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 'TIME' TO T-OP.
           CALL 'PACTSO' USING T-OP T-RC T-NOW.
           MOVE T-NOW TO T-DL.
           PERFORM ONE-DEADLINE 20 TIMES.
           COMPUTE T-DL = T-NOW - 100.
           MOVE 'LA' TO TL-I.
           PERFORM WAIT-AND-SHOW.
           STOP RUN.
       ONE-DEADLINE.
           ADD 1 TO T-I.
           MOVE T-I TO T-NUM.
           MOVE T-NUM TO TL-I.
           ADD 150 TO T-DL.
           PERFORM WAIT-AND-SHOW.
       WAIT-AND-SHOW.
           MOVE 'DLWT' TO T-OP.
           CALL 'PACTSO' USING T-OP T-RC T-DL.
           MOVE T-RC TO TL-RC.
           MOVE 'TIME' TO T-OP.
           CALL 'PACTSO' USING T-OP T-RC T-NOW.
           MOVE T-DL TO TL-DL.
           MOVE T-NOW TO TL-NOW.
           DISPLAY T-LINE.
ZZ
//COBT     EXEC PGM=IKFCBL00,COND=(0,NE),
//         PARM='LOAD,LIB,SUPMAP,SIZE=2048K,BUF=1024K'
//SYSPRINT DD SYSOUT=A
//SYSPUNCH DD DUMMY
//SYSUT1   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSLIN   DD DSN=&&OBJT,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(80,(500,100)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DSN=HERC01.PACMAN.R20.COBOL(PACTSOT),DISP=SHR
//SYSLIB   DD DSN=HERC01.PACMAN.R20.COPY,DISP=SHR
//ASMT     EXEC PGM=IFOX00,COND=(0,NE),PARM='OBJECT,NODECK,NOXREF'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=SYS1.AMODGEN,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(3,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(3,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(3,1))
//SYSPRINT DD SYSOUT=A
//SYSGO    DD DSN=&&OBJAT,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(80,(500,100)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD DATA,DLM=ZZ
*        PACTSO : TSO LINE-MODE SCREEN SERVICE FOR PACPLAT (MVS-8).
*        CALL 'PACTSO' USING OP RC [MS]
*          OP X(4)  'CLS ' = NEXT LINE-MODE OUTPUT STARTS AT LINE 1
*                   OF A FRESH SCREEN (STLINENO LINE=1), SO A FRAME
*                   NEVER OVERFLOWS INTO THE TSO '***' PAGING PROMPT.
*                   'WAIT' = PAUSE 3 SECONDS (STIMER), NO TERMINAL
*                   I/O AT ALL (MVS-GS: THE FINAL SCALED SCREEN STAYS
*                   VISIBLE BEFORE THE LINE-MODE END LINES).
*                   MVS-RT (D33, PROBE E14): 'TIME' = MS := MILLI-
*                   SECONDS SINCE THE FIRST TIME CALL (STCK); 'DLWT' =
*                   WAIT UNTIL THE ABSOLUTE DEADLINE MS (STIMER WAIT,
*                   MICVL FOR THE REMAINDER ONLY), RC 4 IF ALREADY
*                   PASSED. MS S9(9) COMP. BOTH WORK IN ANY ADDRESS
*                   SPACE (BATCH TOO).
*          RC S9(4) COMP  0 = DONE, 4 = NOT A TSO FOREGROUND SESSION
*                   (BATCH: NOTHING IS ISSUED), 8 = UNKNOWN OP.
*        ONLY PACPLAT MAY CALL THIS MODULE.
PACTSO   CSECT
         STM   14,12,12(13)
         BALR  12,0
         USING *,12
         ST    13,SAVE+4
         LA    14,SAVE
         ST    14,8(13)
         LR    13,14
         LM    2,3,0(1)
         LA    3,0(3)
         LA    4,8
         CLC   0(4,2),=C'TIME'
         BE    DOTIME
         CLC   0(4,2),=C'DLWT'
         BE    DODLWT
         CLC   0(4,2),=C'CLS '
         BE    KNOWN
         CLC   0(4,2),=C'WAIT'
         BNE   DONE
KNOWN    DS    0H
         LA    4,4
         L     1,X'224'            PSAAOLD: CURRENT ASCB
         L     1,X'3C'(1)          ASCBTSB: ZERO UNLESS TSO USER
         LTR   1,1
         BZ    DONE
         CLC   0(4,2),=C'WAIT'
         BE    PAUSE
         STLINENO LINE=1
         LR    4,15
         B     DONE
PAUSE    DS    0H
         STIMER WAIT,BINTVL=WAITT
         SR    4,4
         B     DONE                MVS-S1: NEVER FALL INTO DOTIME
DOTIME   DS    0H
         L     5,8(1)              THIRD PARAMETER: MS
         LA    5,0(5)
         BAL   14,NOWMS
         ST    1,0(5)
         SR    4,4
         B     DONE
DODLWT   DS    0H
         L     5,8(1)
         LA    5,0(5)
         BAL   14,NOWMS
         L     0,0(5)              DEADLINE (MS)
         SR    0,1                 REMAINDER = DEADLINE - NOW
         BNP   LATE
         LR    1,0                 THE REMAINDER INTO R1 (M USES R1)
         M     0,=F'1000'          MS -> US IN R0/R1
         SLDL  0,12                US -> TOD UNITS (BIT 51 = 1 US)
         STM   0,1,MICDW
         STIMER WAIT,MICVL=MICDW
         SR    4,4
         B     DONE
LATE     DS    0H
         LA    4,4
         B     DONE
DONE     DS    0H
         STH   4,0(3)
         L     13,SAVE+4
         LM    14,12,12(13)
         SR    15,15
         BR    14
*        NOWMS: R1 := MILLISECONDS SINCE T0 (T0 = THE FIRST CALL).
*        64-BIT TOD DIFFERENCE, >> 12 = US, / 1000. USES R0, R1, R15;
*        FETCH THE PARAMETERS BEFORE THE CALL (R1 IS OVERWRITTEN).
NOWMS    DS    0H
         STCK  NOW
         CLI   T0SET,1
         BE    HAVET0
         MVC   T0,NOW
         MVI   T0SET,1
HAVET0   DS    0H
         LM    0,1,NOW
         SL    1,T0+4
         BC    3,NOBORROW          CC 2/3: NO BORROW
         BCTR  0,0
NOBORROW DS    0H
         SL    0,T0
         SRDL  0,12                US IN R0/R1
         D     0,=F'1000'          MS IN R1 (REMAINDER IN R0)
         BR    14
SAVE     DC    18F'0'
         DS    0D
T0       DC    D'0'
NOW      DC    D'0'
MICDW    DC    D'0'
T0SET    DC    X'00'
WAITT    DC    F'300'              3 SECONDS (UNITS OF 0.01 S)
         LTORG
         END
ZZ
//LINKT    EXEC PGM=IEWL,COND=(0,NE),PARM='LIST,XREF'
//SYSLIN   DD DSN=&&OBJT,DISP=(OLD,DELETE)
//         DD DSN=&&OBJAT,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSLMOD  DD DSN=HERC01.PACMAN.R20.LOAD(PACTSOT),DISP=OLD
//SYSLIB   DD DSN=SYS1.COBLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD SYSOUT=A
//SYSIN    DD *
 ENTRY PACTSOT
