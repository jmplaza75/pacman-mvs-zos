/*
//SYSTSIN  DD *
  ALLOC F(PACHS) DA('HERC01.PACMAN.R20.HSTEST(HS16)') SHR REUSE
  CALL 'HERC01.PACMAN.R20.LOAD(PACMAIN)' 'TSO AI0 2           A'
