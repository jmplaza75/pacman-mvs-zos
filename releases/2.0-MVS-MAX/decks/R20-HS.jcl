/*
//HSCLS1   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=HERC01.PACMAN.R20.HSTEST(HSCLY),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = A
IF &W = A THEN DO
  IF &SYSDSN('HERC01.PACMAN.R20.HSCL.DATA') = OK THEN +
    ALLOC F(PACHS) DA('HERC01.PACMAN.R20.HSCL.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
LISTALC STATUS
IF &W = A THEN FREE F(PACHS)
WRITE HSCL END
ZZ
//HSCLS2   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=HERC01.PACMAN.R20.HSTEST(HSCLN),DISP=OLD
//SYSUT1   DD DATA,DLM=ZZ
PROC 0
SET &W = A
IF &W = A THEN DO
  IF &SYSDSN('HERC01.PACMAN.R20.HSCL.DATA') = OK THEN +
    ALLOC F(PACHS) DA('HERC01.PACMAN.R20.HSCL.DATA(HISCORE)') SHR REUSE
  ELSE ALLOC F(PACHS) DUMMY REUSE
END
LISTALC STATUS
IF &W = A THEN FREE F(PACHS)
WRITE HSCL END
ZZ
//HSCLT    EXEC PGM=IKJEFT01,COND=EVEN
//SYSTSPRT DD SYSOUT=A
//SYSTSIN  DD *
  EXEC 'HERC01.PACMAN.R20.HSTEST(HSCLY)'
  DELETE 'HERC01.PACMAN.R20.HSCL.DATA'
  EXEC 'HERC01.PACMAN.R20.HSTEST(HSCLN)'
  LISTDS 'HERC01.PACMAN.R20.HSTEST' MEMBERS
