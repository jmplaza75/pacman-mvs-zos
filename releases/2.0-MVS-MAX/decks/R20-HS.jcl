//PACBLDHS JOB (1),'PACMAN HS',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//* PREFIX HERC01.PACMAN.R20
//LINK     EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD *
PACMAN-RUN-ONLY-NO-BUILD HERC01.PACMAN.R20.LOAD(PACMAIN)
/*
//SYSUT2   DD SYSOUT=A
//HSMARK   EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD *
PACMAN-HS-RUNS-FOLLOW
/*
//SYSUT2   DD SYSOUT=A
//HSDEL0   EXEC PGM=IEFBR14,COND=(0,NE)
//D1       DD DSN=HERC01.PACMAN.R20.HSTEST,DISP=(MOD,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1))
//D2       DD DSN=HERC01.PACMAN.R20.HSFULL,DISP=(MOD,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1))
//D3       DD DSN=HERC01.PACMAN.R20.HSCL.DATA,DISP=(MOD,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1))
//HSALC    EXEC PGM=IEFBR14,COND=(0,NE)
//D1       DD DSN=HERC01.PACMAN.R20.HSTEST,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(5,1,5)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80)
//D2       DD DSN=HERC01.PACMAN.R20.HSFULL,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(5,1,1)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80)
//D3       DD DSN=HERC01.PACMAN.R20.HSCL.DATA,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(1,1,5)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=80)
//HSSEED1  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=HERC01.PACMAN.R20.HSTEST(HS9),DISP=OLD
//SYSUT1   DD *
9999999 PACHS001 099
/*
//HSSEED2  EXEC PGM=IEBGENER,COND=(0,NE)
