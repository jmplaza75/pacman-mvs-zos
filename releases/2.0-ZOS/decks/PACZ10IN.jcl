//PACZ10IN JOB 1,'PACMAN ZOS10 PACZ10I',CLASS=7,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//PROM1    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=A
//I        DD DSN=@@HLQ@@.PACMAN.RZ.LOAD,DISP=SHR
//O        DD DSN=@@HLQ@@.PACMAN.LOAD,DISP=SHR
//SYSIN    DD *
  COPY OUTDD=O,INDD=I
  SELECT MEMBER=((PACMAIN,,R))
/*
