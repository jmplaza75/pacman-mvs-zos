/* REXX SHOWCEE - ZOS-4 READ-ONLY: SHOW THIS SESSION'S CEEOPTS DD   */
/* NO WRITE, NO ALLOC, NO FREE: LISTDSI AND EXECIO DISKR ONLY.      */
X = LISTDSI('CEEOPTS' 'FILE')
SAY 'SHOWCEE LISTDSI RC' X 'DSN' SYSDSNAME 'MEMBER' SYSMEMBER
SAY 'SHOWCEE RECFM' SYSRECFM 'LRECL' SYSLRECL 'DSORG' SYSDSORG
'EXECIO * DISKR CEEOPTS (STEM L. FINIS'
IF RC <> 0 THEN DO
  SAY 'SHOWCEE EXECIO RC' RC
  EXIT 0
END
SAY 'SHOWCEE' L.0 'RECORD(S)'
DO I = 1 TO L.0
  SAY 'CEE>' STRIP(L.I, 'T')
END
EXIT 0
